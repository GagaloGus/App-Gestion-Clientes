{
  "name": "app-gestion-clientes",
  "version": "1.0.2",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:app-gestion-clientes": "node dist/app-gestion-clientes/server/server.mjs",
    "electron": "electron .",
    "build:exe": "ng build & electron-builder",
    "build:android": "node -e \"fs.rmSync('android', { recursive: true, force: true })\" & ng build & npx cap add android",
    "build:ios": "node -e \"fs.rmSync('ios', { recursive: true, force: true })\" & ng build & npx cap add ios",
    "build:phone": "node -e \"fs.rmSync('android', { recursive: true, force: true })\" & node -e \"fs.rmSync('ios', { recursive: true, force: true })\" & ng build & npx cap add android & npx cap add ios"

  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.1",
    "@capacitor/android": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4",
    "@supabase/supabase-js": "^2.99.1",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.1",
    "@angular/cli": "^21.2.1",
    "@angular/compiler-cli": "^21.2.0",
    "@capacitor/cli": "^8.3.4",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "com.apptwin.alizzia",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "portable",
      "icon": "public/img/logo_alizzia.ico"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "package.json"
    ]
  }
}
